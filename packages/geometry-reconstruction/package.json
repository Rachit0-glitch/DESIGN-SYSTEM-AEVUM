{
  "name": "@aevum/geometry-reconstruction",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aevum/assets": "workspace:*",
    "@aevum/command-engine": "workspace:*",
    "@aevum/document-model": "workspace:*",
    "@aevum/multiview-reconstruction": "workspace:*",
    "@aevum/renderer-3d": "workspace:*",
    "@aevum/shared": "workspace:*",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "zod": "4.4.3"
  }
}
