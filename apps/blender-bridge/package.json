{
  "name": "@aevum/blender-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "smoke": "node dist/smoke.js"
  },
  "dependencies": {
    "@aevum/assets": "workspace:*",
    "@aevum/command-engine": "workspace:*",
    "@aevum/document-model": "workspace:*",
    "@aevum/lighting": "workspace:*",
    "@aevum/mcp-protocol": "workspace:*",
    "@aevum/renderer-3d": "workspace:*",
    "@aevum/rigging": "workspace:*",
    "@aevum/scene-runtime": "workspace:*",
    "@aevum/shared": "workspace:*",
    "zod": "4.4.3"
  }
}
