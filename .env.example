# AEVUM AI Reconstruction Engine environment template.
# Keep real secrets in the ignored .env file or a deployment secret manager.

NODE_ENV=development
LOG_LEVEL=info
AEVUM_RUNTIME_MODE=full
AEVUM_SERVICE=platform
AEVUM_FEATURE_FLAGS=phase4,local-dev
PORT=

# Production API. Origins must be explicit HTTPS origins in production.
API_ALLOWED_ORIGINS=http://localhost:4173
API_MAX_PAYLOAD_BYTES=16384
API_REQUEST_TIMEOUT_MS=10000
API_RATE_LIMIT_PER_MINUTE=120
API_DEPLOYMENT_VERSION=development

# Public Studio build configuration. Never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AEVUM_API_URL=http://localhost:3001
VITE_AEVUM_MCP_URL=http://localhost:3010

# Supabase project and API credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_STORAGE_BUCKET=
SUPABASE_JWT_SECRET=

# Supabase Postgres pooler and direct migration connections
DATABASE_URL=
DATABASE_URL_DIRECT=
DATABASE_SSL_MODE=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Optional future cache and queue endpoints
CACHE_URL=redis://localhost:6379/0
QUEUE_URL=redis://localhost:6379/1

# Local paths and execution policy
LOCAL_FILE_WORKSPACE=./.aevum-workspace
SANDBOX_ROOT=./.aevum-sandbox
BLENDER_EXECUTABLE_PATH=
# Deprecated compatibility alias. Prefer BLENDER_EXECUTABLE_PATH.
BLENDER_EXECUTABLE=
BLENDER_BRIDGE_HOST=127.0.0.1
BLENDER_HEADLESS=true
BLENDER_MAX_JOB_SECONDS=600
BLENDER_MAX_FILE_MB=500
BLENDER_MAX_OUTPUT_MB=1000
BLENDER_MAX_OBJECTS=100000
BLENDER_MAX_MESHES=50000
BLENDER_MAX_MATERIALS=10000
BLENDER_MAX_CONCURRENT_JOBS=1
MESH_MAX_SELECTED_ELEMENTS=100000
MESH_MAX_OUTPUT_VERTICES=2000000
MESH_MAX_OUTPUT_FACES=2000000
MESH_MAX_TOPOLOGY_GROWTH=8
BEVEL_MAX_SEGMENTS=8
SUBDIVISION_MAX_LEVEL=3
LOOP_CUT_MAX_CUTS=16
UV_MAX_ISLANDS=10000
MESH_MAX_MODIFIERS=64
BLENDER_TEMP_DIR=
SANDBOX_NETWORK_MODE=restricted

# Runtime limits
RENDER_WORKER_CONCURRENCY=1
RENDER_WORKER_MAX_PIXELS=16777216
SCENE_RUNTIME_STRICT_MODE=true
SCENE_RUNTIME_MAX_DEPTH=1000
SCENE_RUNTIME_MAX_NODES=100000
SCENE_RUNTIME_ENABLE_CACHE=true
SCENE_RUNTIME_CACHE_SIZE=500
SCENE_RUNTIME_DIAGNOSTICS=true
SCENE_RUNTIME_INSPECTION_MODE=false

# Deterministic reconstruction limits and feature policy
RECONSTRUCTION_DEFAULT_QUALITY_MODE=DRAFT
RECONSTRUCTION_MAX_REGIONS=5000
RECONSTRUCTION_MAX_PROPOSAL_NODES=10000
RECONSTRUCTION_STRICT_MODE=true
RECONSTRUCTION_DIAGNOSTICS=true
RECONSTRUCTION_ENABLE_COMPONENT_INFERENCE=true
RECONSTRUCTION_ENABLE_TOKEN_INFERENCE=true
RECONSTRUCTION_ALLOW_RASTER_FALLBACK=true
MCP_SERVER_HOST=127.0.0.1
MCP_REQUIRE_AUTH=false
MCP_SERVER_PORT=3010
MCP_AUTH_MODE=development
MCP_ALLOWED_ORIGINS=http://localhost:3000
MCP_REQUEST_TIMEOUT_MS=30000
MCP_TOOL_TIMEOUT_MS=20000
MCP_DATABASE_TIMEOUT_MS=10000
MCP_AUTH_TIMEOUT_MS=5000
MCP_MAX_PAYLOAD_BYTES=1048576
MCP_MAX_RESPONSE_BYTES=5242880
MCP_MAX_TOOL_INPUT_BYTES=524288
MCP_MAX_NODE_PAYLOAD_BYTES=262144
MCP_MAX_AUDIT_PAYLOAD_BYTES=65536
MCP_MAX_BATCH_SIZE=50
MCP_ENABLE_AUDIT_LOGS=true
MCP_ENABLE_DRY_RUN=true
MCP_ENABLE_TRANSACTIONS=true
MCP_ENABLE_IDEMPOTENCY=true
MCP_SHUTDOWN_GRACE_MS=15000
MCP_RATE_LIMIT_ENABLED=true
MCP_RATE_LIMIT_READ_PER_MINUTE=120
MCP_RATE_LIMIT_WRITE_PER_MINUTE=30
MCP_IDEMPOTENCY_TTL_SECONDS=86400
MCP_AUDIT_RETENTION_DAYS=90
MCP_DEPLOYMENT_VERSION=development
MCP_TRUST_PROXY=false

# Agent orchestration runtime (no new provider credential is required for deterministic mode)
AGENT_ENABLED=true
AGENT_MCP_URL=http://localhost:3010
AGENT_FIXTURE_MODE=false
AGENT_MAX_STEPS=50
AGENT_MAX_TOOL_CALLS=100
AGENT_MAX_WRITES=20
AGENT_MAX_REPLANS=5
AGENT_MAX_RETRIES=3
AGENT_MAX_EXECUTION_MS=300000
AGENT_MAX_VALIDATION_PASSES=5
AGENT_CONTEXT_MAX_NODES=500
AGENT_CONTEXT_MAX_ASSETS=100
AGENT_CONTEXT_MAX_TIMELINES=50
AGENT_CONTEXT_MAX_VALIDATION_ISSUES=200
AGENT_CONTEXT_MAX_HISTORY=50
AGENT_CONTEXT_MAX_CHARACTERS=200000
AGENT_CONTEXT_MAX_TOKENS=50000
AGENT_APPROVAL_POLICY=AUTO_SAFE_WRITE
AGENT_DRY_RUN_WRITES=true
AGENT_PERSIST_SESSIONS=true
AGENT_PERSIST_OBSERVATIONS=true
AGENT_REASONING_PROVIDER=deterministic

# Future Docker and service placeholders
COMPOSE_PROJECT_NAME=aevum
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=3001
MCP_PORT=3010
RENDER_WORKER_PORT=3020
EXPORT_WORKER_PORT=3030
BLENDER_BRIDGE_PORT=3040
AGENT_WORKER_PORT=3050
NETWORK_NAME=aevum-network
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
